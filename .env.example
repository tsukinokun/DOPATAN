# Supabase(未設定ならゲスト専用で動く)。service_role キーは絶対に入れないこと
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# スマホ通知(Web Push)。npx web-push generate-vapid-keys で作る。未設定なら通知は「準備中」になる
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# ここから下はサーバー(Vercel)だけに置く。NEXT_PUBLIC_ を付けないこと
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Vercel の定期実行が付ける合言葉(Vercel が自動で使う)
CRON_SECRET=
# Supabase の dopatan_private.push_config に入れたのと同じ値(16文字以上)
PUSH_SECRET=
